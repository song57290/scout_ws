set -euo pipefail

echo "== OS =="
lsb_release -a 2>/dev/null || cat /etc/os-release

echo -e "\n== GPU/Driver =="
nvidia-smi || true

echo -e "\n== Python/Pip =="
which python || true
python --version || true
which python3 || true
python3 --version || true
pip3 --version || true

echo -e "\n== Virtualenv? =="
echo "VIRTUAL_ENV=${VIRTUAL_ENV:-}"

echo -e "\n== Torch/CUDA =="
python3 - <<'PY'
try:
    import torch, torchvision
    print("torch:", torch.__version__)
    print("cuda_available:", torch.cuda.is_available())
    print("torch.version.cuda:", torch.version.cuda)
    print("device_count:", torch.cuda.device_count())
    if torch.cuda.is_available():
        print("current_device:", torch.cuda.current_device())
        print("name:", torch.cuda.get_device_name(0))
except Exception as e:
    print("torch import error:", e)
PY

echo -e "\n== ROS distro/paths =="
echo "ROS_DISTRO=${ROS_DISTRO:-}"
echo "RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-}"
echo "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-}"
echo "AMENT_PREFIX_PATH=${AMENT_PREFIX_PATH:-}" | tr ':' '\n' | sed 's/^/  /'
echo "PYTHONPATH=${PYTHONPATH:-}"

echo -e "\n== Workspaces sourced? =="
env | grep -E 'ROS_DISTRO|UNDERLAY|OVERLAY|AMENT|COLCON_CURRENT_PREFIX' | sort

echo -e "\n== Installed image transport plugins =="
apt-cache policy ros-${ROS_DISTRO:-humble}-image-transport ros-${ROS_DISTRO:-humble}-image-transport-plugins | sed 's/^/  /'

echo -e "\n== OpenCV/Qt backends =="
python3 - <<'PY'
try:
    import cv2, os
    print("cv2:", cv2.__version__)
    print("QT_QPA_PLATFORM:", os.environ.get("QT_QPA_PLATFORM"))
    print("XDG_SESSION_TYPE:", os.environ.get("XDG_SESSION_TYPE"))
except Exception as e:
    print("opencv import error:", e)
PY

echo -e "\n== ROS graph snapshot (topics/nodes) =="
ros2 node list
ros2 topic list
ros2 topic list -t | grep -E '/fire|/recall|image_raw|compressed' || true

echo -e "\n== QoS details for key topics =="
for T in /fire/annotated_image/compressed /fire/annotated_image /recall_active /fire/detected /camera/image_raw; do
  echo "--- $T"; ros2 topic info -v $T || true; done
